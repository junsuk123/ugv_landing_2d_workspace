{
  "schema_version": "minimal_common_observation_v3",
  "profile": "planar_visibility_v2",
  "policy_vector_dimension": 12,
  "policy_decision_rate_hz": 10,
  "source_of_truth": "landing2d.observation.vectorSchema",
  "groups": {
    "relative": ["relative_x", "relative_height", "relative_vx"],
    "motion": ["ugv_vx", "drone_vz", "drone_sinTheta", "drone_cosTheta", "drone_pitchRate"],
    "quality": ["ugv_visionUpdated", "ugv_visionAge", "drone_navigationValid", "drone_navigationAge"]
  },
  "graph_projection": {
    "schema": "minimal_observation_rgat_v3",
    "node_count": 7,
    "feature_count_per_node": 6,
    "semantic_edge_count": 9,
    "self_edge_count": 7,
    "relation_type_count": 4,
    "hidden_dimension": 16,
    "graph_dimension": 16,
    "readout": "grouped_factorized"
  },
  "causal_boundary": {
    "allowed": ["current and past marker measurements", "causal UGV estimate", "fused drone navigation", "measurement validity and age"],
    "excluded": ["hidden pad truth", "future state", "absolute horizontal position", "reward", "terminal outcome", "supervisor or authorization state"]
  }
}
